{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/concours-ifsi-infirmier", "destination": "/concours-ifsi-infirmier.html" },
    { "source": "/concours-aide-soignant", "destination": "/concours-aide-soignant.html" },
    { "source": "/concours-ambulancier", "destination": "/concours-ambulancier.html" },
    { "source": "/concours-sapeur-pompier", "destination": "/concours-sapeur-pompier.html" },
    { "source": "/concours-auxiliaire-puericulture", "destination": "/concours-auxiliaire-puericulture.html" },
    { "source": "/concours-atsem", "destination": "/concours-atsem.html" },
    { "source": "/concours-ash", "destination": "/concours-ash.html" },
    { "source": "/concours-adjoint-administratif", "destination": "/concours-adjoint-administratif.html" },
    { "source": "/blog-erreurs-concours-ifsi", "destination": "/blog-erreurs-concours-ifsi.html" },
    { "source": "/blog-programme-concours-ambulancier", "destination": "/blog-programme-concours-ambulancier.html" },
    { "source": "/blog-reussir-concours-aide-soignant", "destination": "/blog-reussir-concours-aide-soignant.html" },
    { "source": "/cgv", "destination": "/cgv.html" },
    { "source": "/mentions-legales", "destination": "/mentions-legales.html" },
    { "source": "/politique-confidentialite", "destination": "/politique-confidentialite.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
